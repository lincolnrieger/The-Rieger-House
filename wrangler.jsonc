{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rieger-house",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "observability": { "enabled": true },

  // The frontend in public/ is served as static assets. Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rieger-house",
      "database_id": "267cbc23-96c9-425c-a928-4caeb07bdf69",
      "migrations_dir": "migrations"
    }
  ]
}
